{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:shared-host": "MALLOC_ARENA_MAX=2 MIMALLOC_ARENA_RESERVE=64MiB RAYON_NUM_THREADS=2 TOKIO_WORKER_THREADS=2 ROLLDOWN_WORKER_THREADS=2 node --disable-wasm-trap-handler --wasm-max-mem-pages=4096 node_modules/vite/bin/vite.js build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@stylistic/eslint-plugin": "^6.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.23.0"
    },
    "dependencies": {
        "@inertiajs/react": "^3.11.0",
        "@inertiajs/vite": "^3.11.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tailwindcss/vite": "^4.3.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.7",
        "globals": "^17.14.0",
        "laravel-vite-plugin": "^3.2",
        "lucide-react": "^1.73.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "recharts": "^3.10.1",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.7.2",
        "vite": "^8.3.8"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.68.3",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1"
    }
}
